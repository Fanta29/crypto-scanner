# Copier en .env pour le développement local (vercel dev). Ne jamais committer .env.
# Clé Etherscan API V2 (multichaîne, chainid=137 pour Polygon). Une clé Polygonscan V1 n'est pas valide en V2.
ETHERSCAN_API_KEY=
# Facultatif : URL RPC Polygon (Alchemy, Infura, QuickNode…). Contient souvent une clé : côté serveur uniquement.
POLYGON_RPC_URL=
